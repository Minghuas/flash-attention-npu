#include "aicpu_api.h"
#include "fa_metadata_args.h"
#include "fa_task_schedule.h"
#include "fa_split.h"
#include "tilingdata.h"
#include <cstdint>
#include <cstring>

namespace {
constexpr uint32_t Q_TILE_CEIL = 128;
constexpr uint32_t N_SPLIT_HELPER = 2;
constexpr uint32_t MASK_TYPE_NO_MASK = 0;
constexpr uint32_t MASK_TYPE_CAUSAL = 1;
// Keep in sync with FaiKenel::MaskType::MASK_BAND.
constexpr uint32_t MASK_TYPE_BAND = 2;

inline uint32_t CeilDiv(uint32_t a, uint32_t b)
{
    return (b == 0) ? 0 : (a + b - 1) / b;
}

inline uint32_t GetQNBlockTile(uint32_t qSeqlen, uint32_t groupSize)
{
    uint32_t qNBlockTile = (qSeqlen != 0)
        ? (Q_TILE_CEIL / qSeqlen) / N_SPLIT_HELPER * N_SPLIT_HELPER
        : Q_TILE_CEIL;
    qNBlockTile = qNBlockTile < groupSize ? qNBlockTile : groupSize;
    qNBlockTile = qNBlockTile < 1u ? 1u : qNBlockTile;
    return qNBlockTile;
}

inline void InitSchedulerHeader(SchedulerHeader& header, uint32_t coreNum)
{
    std::memset(&header, 0, sizeof(SchedulerHeader));
    header.version = fa_metadata::TASK_METADATA_VERSION;
    header.coreNum = coreNum;
    header.status = fa_metadata::TASK_METADATA_OK;
}

inline uint32_t BuildBatchPlans(BatchPlan* plans, HeadPlan* headPlans, MaskPlan* maskPlans,
                            uint32_t batch, uint32_t groupSize, uint32_t maskType,
                            int64_t windowLeft, int64_t windowRight, const fa_split::SplitContext& ctx)
{
    uint32_t headPlanBase = 0;
    uint32_t maskPlanBase = 0;
    for (uint32_t b = 0; b < batch; ++b) {
        const fa_split::BatchParams p = fa_split::getBatchParams(b, groupSize, ctx);
        BatchPlan& plan = plans[b];
        std::memset(&plan, 0, sizeof(BatchPlan));
        plan.qSeqlen = p.qSeqlen;
        plan.kvSeqlen = p.kvSeqlen;
        plan.qNBlockTile = p.curQNBlockTile;
        plan.qNBlockNumPerGroup = p.qNBlockNumPerGroup;
        plan.qNBlockNum = p.curQNBlockNum;
        plan.qSBlockTile = p.curQSBlockTile;
        plan.qSBlockNum = p.curQSBlockNum;
        plan.kSBlockTile = p.curKSBlockTile;
        plan.kSBlockNum = p.curKSBlockNum;
        plan.kSBlockTail = p.curKSBlockTail;
        plan.appendStartStack = ctx.kvNewSeqlen == 0
            ? p.curKSBlockNum
            : (static_cast<uint32_t>(p.kvSeqlen - ctx.kvNewSeqlen) + p.curKSBlockTile - 1) /
                  p.curKSBlockTile;
        plan.headPlanBase = headPlanBase;
        plan.headPlanCount = p.curQNBlockNum;
        plan.maskPlanBase = maskPlanBase;
        plan.maskPlanCount = p.curQSBlockNum;
        for (uint32_t n = 0; n < p.curQNBlockNum; ++n) {
            const uint32_t nInGroup = n % p.qNBlockNumPerGroup;
            const uint32_t kvHead = n / p.qNBlockNumPerGroup;
            HeadPlan& head = headPlans[headPlanBase + n];
            head.qNStart = kvHead * groupSize + nInGroup * p.curQNBlockTile;
            head.qNSize = nInGroup + 1 == p.qNBlockNumPerGroup
                ? groupSize - nInGroup * p.curQNBlockTile
                : p.curQNBlockTile;
            head.kvHeadOffset = kvHead;
        }
        headPlanBase += p.curQNBlockNum;
        for (uint32_t s = 0; s < p.curQSBlockNum; ++s) {
            const uint32_t qSSize = s + 1 == p.curQSBlockNum
                ? p.qSeqlen - s * p.curQSBlockTile : p.curQSBlockTile;
            maskPlans[maskPlanBase + s] = fa_metadata::BuildMaskPlan(
                p.qSeqlen, p.kvSeqlen, s, p.curQSBlockTile, qSSize, maskType,
                windowLeft, windowRight);
        }
        maskPlanBase += p.curQSBlockNum;
    }
    return headPlanBase;
}

inline void BuildAppendPlan(AppendPlan& plan, const fa_split::BatchParams& p,
                            const fa_split::SplitContext& ctx)
{
    const uint32_t kvNewSeqlen = ctx.kvNewSeqlen > 0 ? static_cast<uint32_t>(ctx.kvNewSeqlen) : 0U;
    const uint32_t kvSeqlenOld = p.kvSeqlen - kvNewSeqlen;
    plan.kvSeqlenOld = kvSeqlenOld;
    plan.kvStartOld = kvNewSeqlen == 0U ? 0U :
        (kvSeqlenOld + fa_split::MAX_KV_STACK_LEN - 1) / fa_split::MAX_KV_STACK_LEN;
    plan.kvLoopNumTotalNew = kvNewSeqlen == 0U ? 0U :
        (kvNewSeqlen + fa_split::MAX_KV_STACK_LEN - 1) / fa_split::MAX_KV_STACK_LEN;
    plan.kvNewSeqlen = kvNewSeqlen;
    plan.flags = kvNewSeqlen != 0U ? fa_metadata::APPEND_PLAN_ENABLED : 0U;
    plan.reserved[0] = 0;
    plan.reserved[1] = 0;
    plan.reserved[2] = 0;
}

inline void BuildAddressPlan(AddressPlan& plan, uint32_t batchIdx, const FAMetadataArgs& args,
                             const fa_split::SplitContext& ctx, uint32_t totalQTokens)
{
    uint32_t qPrefix = 0;
    uint32_t kvPrefix = 0;
    for (uint32_t i = 0; i < batchIdx; ++i) {
        qPrefix += ctx.seqlens_q_cpu == nullptr ? static_cast<uint32_t>(ctx.seqlen_q)
                                                : static_cast<uint32_t>(ctx.seqlens_q_cpu[i]);
        kvPrefix += ctx.seqlens_k_cpu == nullptr ? 0U : static_cast<uint32_t>(ctx.seqlens_k_cpu[i]);
    }
    const uint64_t qStride = static_cast<uint64_t>(args.numHeads) * args.embeddingSize;
    const uint64_t oStride = static_cast<uint64_t>(args.numHeads) * args.embeddingSizeV;
    const uint64_t kStride = static_cast<uint64_t>(args.numHeadsK) * args.embeddingSize;
    const uint64_t vStride = static_cast<uint64_t>(args.numHeadsK) * args.embeddingSizeV;
    const bool append = args.kvNewSeqlen != 0U;
    const uint32_t qBase = args.isVarlen != 0U ? qPrefix : batchIdx * args.maxQSeqlen;
    const uint32_t kvBase = append ? batchIdx * args.kvCacheSeqlen : kvPrefix;
    plan.qBOffset = static_cast<uint64_t>(qBase) * qStride;
    plan.oBOffset = static_cast<uint64_t>(qBase) * oStride;
    plan.kBOffset = args.pagedKV != 0U ? 0U : static_cast<uint64_t>(kvBase) * kStride;
    plan.vBOffset = args.pagedKV != 0U ? 0U : static_cast<uint64_t>(kvBase) * vStride;
    plan.lseBOffset = args.isVarlen != 0U
        ? qBase : static_cast<uint64_t>(qBase) * args.numHeads;
    plan.blockBOffset = args.pagedKV != 0U
        ? static_cast<uint64_t>(batchIdx) * args.maxNumBlocksPerBatch : 0U;
    plan.kNewBOffset = static_cast<uint64_t>(batchIdx) * args.kvNewSeqlen * kStride;
    plan.vNewBOffset = static_cast<uint64_t>(batchIdx) * args.kvNewSeqlen * vStride;
    plan.lseHeadStride = args.isVarlen != 0U ? totalQTokens : args.maxQSeqlen;
}

inline bool BuildSchedulerTasks(FAMetadataArgs* metaArgs, FAInferTilingData* tilingData,
                                const fa_split::SplitContext& ctx, uint32_t groupSize)
{
    auto* metaBase = reinterpret_cast<uint8_t*>(metaArgs->metaOutAddr);
    auto* header = reinterpret_cast<SchedulerHeader*>(metaBase + fa_metadata::SchedulerHeaderOffset());
    auto* ranges = reinterpret_cast<CoreTaskRange*>(metaBase + fa_metadata::CoreRangeOffset());
    InitSchedulerHeader(*header, metaArgs->blockDim);
    header->flashDecodeFlag = tilingData->flashDecodeFlag;
    header->batchPlanOffset = fa_metadata::BatchPlanOffset(
        metaArgs->blockDim, metaArgs->batch, metaArgs->maxQSeqlen, metaArgs->numHeads,
        metaArgs->taskCapacityFactor);
    header->batchPlanBytes = static_cast<uint64_t>(metaArgs->batch) * sizeof(BatchPlan);
    header->batchPlanCount = metaArgs->batch;
    header->headPlanOffset = fa_metadata::HeadPlanOffset(
        metaArgs->blockDim, metaArgs->batch, metaArgs->maxQSeqlen, metaArgs->numHeads,
        metaArgs->taskCapacityFactor);
    header->headPlanBytes = static_cast<uint64_t>(metaArgs->headPlanCapacity) * sizeof(HeadPlan);
    header->fdPlanOffset = 0;
    header->fdPlanBytes = 0;
    header->maskPlanOffset = fa_metadata::MaskPlanOffsetForCapacity(
        metaArgs->blockDim, metaArgs->batch, metaArgs->maxQSeqlen, metaArgs->numHeads,
        metaArgs->headPlanCapacity, metaArgs->fdPlanCapacity, metaArgs->taskCapacityFactor);
    header->maskPlanBytes = static_cast<uint64_t>(metaArgs->maskPlanCapacity) * sizeof(MaskPlan);
    header->appendPlanOffset = fa_metadata::AppendPlanOffsetForCapacity(
        metaArgs->blockDim, metaArgs->batch, metaArgs->maxQSeqlen, metaArgs->numHeads,
        metaArgs->headPlanCapacity, metaArgs->fdPlanCapacity, metaArgs->maskPlanCapacity,
        metaArgs->taskCapacityFactor);
    header->appendPlanBytes = static_cast<uint64_t>(metaArgs->batch) * sizeof(AppendPlan);
    header->appendPlanCount = metaArgs->batch;
    header->addressPlanOffset = fa_metadata::AddressPlanOffsetForCapacity(
        metaArgs->blockDim, metaArgs->batch, metaArgs->maxQSeqlen, metaArgs->numHeads,
        metaArgs->headPlanCapacity, metaArgs->fdPlanCapacity, metaArgs->maskPlanCapacity, metaArgs->batch,
        metaArgs->taskCapacityFactor);
    header->addressPlanBytes = static_cast<uint64_t>(metaArgs->batch) * sizeof(AddressPlan);
    header->addressPlanCount = metaArgs->batch;
    auto* batchPlans = reinterpret_cast<BatchPlan*>(metaBase + header->batchPlanOffset);
    auto* headPlans = reinterpret_cast<HeadPlan*>(metaBase + header->headPlanOffset);
    auto* maskPlans = reinterpret_cast<MaskPlan*>(metaBase + header->maskPlanOffset);
    auto* appendPlans = reinterpret_cast<AppendPlan*>(metaBase + header->appendPlanOffset);
    auto* addressPlans = reinterpret_cast<AddressPlan*>(metaBase + header->addressPlanOffset);

    const uint32_t actualHeadPlanCount =
        BuildBatchPlans(batchPlans, headPlans, maskPlans, metaArgs->batch, groupSize,
                        tilingData->maskType, tilingData->windowSizeLeft,
                        tilingData->windowSizeRight, ctx);
    for (uint32_t b = 0; b < metaArgs->batch; ++b) {
        BuildAppendPlan(appendPlans[b], fa_split::getBatchParams(b, groupSize, ctx), ctx);
    }
    uint32_t totalQTokens = 0;
    for (uint32_t b = 0; b < metaArgs->batch; ++b) {
        totalQTokens += ctx.seqlens_q_cpu == nullptr ? static_cast<uint32_t>(ctx.seqlen_q)
                                                     : static_cast<uint32_t>(ctx.seqlens_q_cpu[b]);
    }
    for (uint32_t b = 0; b < metaArgs->batch; ++b) {
        BuildAddressPlan(addressPlans[b], b, *metaArgs, ctx, totalQTokens);
    }
    if (actualHeadPlanCount > metaArgs->headPlanCapacity) {
        header->status = fa_metadata::TASK_METADATA_OVERFLOW;
        return false;
    }
    header->headPlanBytes = static_cast<uint64_t>(actualHeadPlanCount) * sizeof(HeadPlan);
    header->headPlanCount = actualHeadPlanCount;
    uint32_t actualMaskPlanCount = 0;
    for (uint32_t b = 0; b < metaArgs->batch; ++b) actualMaskPlanCount += batchPlans[b].maskPlanCount;
    if (actualMaskPlanCount > metaArgs->maskPlanCapacity) {
        header->status = fa_metadata::TASK_METADATA_OVERFLOW;
        return false;
    }
    header->maskPlanCount = actualMaskPlanCount;
    header->maskPlanBytes = static_cast<uint64_t>(actualMaskPlanCount) * sizeof(MaskPlan);

    return fa_metadata::BuildTaskSchedule(*header, ranges, batchPlans, headPlans, *tilingData);
}
}

__global__ __aicpu__ uint32_t ComputeFAMetadataV3(void *args)
{
    FAMetadataArgs *metaArgs = reinterpret_cast<FAMetadataArgs *>(args);
    const bool hasMask = metaArgs->maskType != 0;
    FAInferTilingData *tilingData = reinterpret_cast<FAInferTilingData *>(
        metaArgs->metaOutAddr + fa_metadata::TilingOffset(hasMask));
    const int32_t *seqlensQ = reinterpret_cast<const int32_t *>(metaArgs->seqlensQAddr);
    const int32_t *cacheSeqlens = reinterpret_cast<const int32_t *>(metaArgs->cacheSeqlensAddr);

    std::memset(tilingData, 0, sizeof(FAInferTilingData));

    tilingData->batch = metaArgs->batch;
    tilingData->numHeads = metaArgs->numHeads;
    tilingData->kvHeads = metaArgs->numHeadsK;
    tilingData->embeddingSize = metaArgs->embeddingSize;
    tilingData->embeddingSizeV = metaArgs->embeddingSizeV;
    tilingData->numBlocks = metaArgs->numBlocks;
    tilingData->blockSize = metaArgs->blockSize;
    tilingData->maxNumBlocksPerBatch = metaArgs->maxNumBlocksPerBatch;
    tilingData->maxQSeqlen = metaArgs->maxQSeqlen;
    tilingData->numSplits = metaArgs->numSplits > 0u ? metaArgs->numSplits : 1u;
    // Append-KV fields (0 = append disabled, from the memset above).
    tilingData->kvNewSeqlen = metaArgs->kvNewSeqlen;
    tilingData->kvCacheSeqlen = metaArgs->kvCacheSeqlen;
    uint32_t maxKvSeqlen = 0;
    if (cacheSeqlens != nullptr) {
        for (uint32_t batchIdx = 0; batchIdx < metaArgs->batch; ++batchIdx) {
            uint32_t kvLen = static_cast<uint32_t>(cacheSeqlens[batchIdx]);
            kvLen += metaArgs->kvNewSeqlen;
            if (kvLen > maxKvSeqlen) {
                maxKvSeqlen = kvLen;
            }
        }
    }
    tilingData->maxKvSeqlen = maxKvSeqlen;

    tilingData->maskType = metaArgs->maskType;
    tilingData->windowSizeLeft = metaArgs->windowSizeLeft;
    tilingData->windowSizeRight = metaArgs->windowSizeRight;

    const uint64_t blockDim = static_cast<uint64_t>(metaArgs->blockDim);
    tilingData->mm1OutSize = fa_metadata::Mm1OutSize(blockDim);
    tilingData->smOnlineOutSize = fa_metadata::SmOnlineOutSize(blockDim);
    tilingData->mm2OutSize = fa_metadata::Mm2OutSize(blockDim);
    tilingData->UpdateSize = fa_metadata::UpdateOutSize(blockDim);
    tilingData->workSpaceSize = fa_metadata::WorkSpaceSize(blockDim);

    const uint32_t groupSize = (metaArgs->numHeadsK == 0) ? 1u : (metaArgs->numHeads / metaArgs->numHeadsK);
    uint32_t totalTaskNum = 0;
    uint32_t firstBatchTaskNum = 0;
    uint32_t maxQ = 0;
    uint32_t minQ = 0xFFFFFFFFu;
    for (uint32_t batchIdx = 0; batchIdx < metaArgs->batch; ++batchIdx) {
        uint32_t qSeqlen = metaArgs->maxQSeqlen;
        if (seqlensQ != nullptr) {
            qSeqlen = static_cast<uint32_t>(seqlensQ[batchIdx]);
        }
        const uint32_t curQNBlockTile = GetQNBlockTile(qSeqlen, groupSize);
        const uint32_t qNBlockNumPerGroup = CeilDiv(groupSize, curQNBlockTile);
        const uint32_t curQNBlockNum = qNBlockNumPerGroup * metaArgs->numHeadsK;
        const uint32_t curQSBlockNum = CeilDiv(qSeqlen, Q_TILE_CEIL);
        const uint32_t curTaskNum = curQNBlockNum * curQSBlockNum;
        if (batchIdx == 0) {
            firstBatchTaskNum = curTaskNum;
        }
        totalTaskNum += curTaskNum;
        if (qSeqlen > maxQ) {
            maxQ = qSeqlen;
        }
        if (qSeqlen < minQ) {
            minQ = qSeqlen;
        }
    }
    tilingData->firstBatchTaskNum = firstBatchTaskNum;
    tilingData->totalTaskNum = totalTaskNum;

        const uint32_t bd = metaArgs->blockDim;
        const uint32_t numTasks = metaArgs->batch * metaArgs->numHeadsK;
        // Kernel dispatch cannot read the device-produced tiling header before
        // launch. Use the same shape/capacity bound that host dispatch sees,
        // while task geometry below still uses actual per-batch lengths.
        const uint32_t fdCapacity = metaArgs->maxNumBlocksPerBatch * metaArgs->blockSize;
        const uint32_t fdKvBound = fdCapacity != 0U
            ? fdCapacity + metaArgs->kvNewSeqlen : maxKvSeqlen;
        const bool isLongSeq = (static_cast<double>(numTasks) <= 0.8 * bd) && (fdKvBound >= bd * 512u);
        const bool isShortSeq = (static_cast<double>(numTasks) <= 0.4 * bd) && (fdKvBound >= 1024u);
        const bool fdFlag = (metaArgs->pagedKV != 0) && (metaArgs->isVarlen != 0) &&
            (metaArgs->maskType != MASK_TYPE_BAND) &&
            (metaArgs->maxQSeqlen * groupSize <= 128u) && (metaArgs->maxQSeqlen <= 16u) &&
            (fdKvBound >= 1024u) && (metaArgs->maxQSeqlen > 0u) && (isLongSeq || isShortSeq);
        tilingData->flashDecodeFlag = fdFlag ? 1u : 0u;
        fa_split::SplitContext ctx{};
        ctx.batch_size = static_cast<int32_t>(metaArgs->batch);
        ctx.num_heads = static_cast<int32_t>(metaArgs->numHeads);
        ctx.num_heads_k = static_cast<int32_t>(metaArgs->numHeadsK);
        ctx.seqlen_q = static_cast<int32_t>(metaArgs->maxQSeqlen);
        ctx.head_size_v = static_cast<int32_t>(metaArgs->embeddingSizeV);
        ctx.seqlens_q_cpu = seqlensQ;
        ctx.seqlens_k_cpu = cacheSeqlens;
        ctx.blockDim = bd;
        ctx.num_splits = static_cast<int32_t>(metaArgs->numSplits);
        ctx.kvNewSeqlen = static_cast<int32_t>(metaArgs->kvNewSeqlen);
        if (fdFlag) {
            fa_split::splitBN2S1GS2(tilingData, ctx);
            tilingData->workSpaceSize = fa_metadata::WorkSpaceSize(static_cast<uint64_t>(bd))
                + tilingData->splitLseTotalSize + tilingData->splitOTotalSize;
        }
        if (!BuildSchedulerTasks(metaArgs, tilingData, ctx, groupSize)) {
            AscendC::DataStoreBarrier();
            return 1;
        }

    AscendC::DataStoreBarrier();
    return 0;
}
